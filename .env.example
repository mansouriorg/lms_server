# Copy this file to .env and fill in real values. Never commit .env.
# The server checks these when it starts (src/config/env.schema.ts).

NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lms

# Comma-separated web app origins allowed to call the API
FRONTEND_URLS=http://localhost:3000

# Signs the login tokens: at least 32 random characters. Make one with:
#   openssl rand -hex 32
# The value below is too short on purpose: the server refuses to start
# until you put a real one.
JWT_SECRET=change-me
