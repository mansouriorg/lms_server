// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" // <-- THIS IS THE MAGIC LINE!
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  CENTER_ADMIN
  SUPER_ADMIN
}

enum StageStatus {
  DRAFT
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  NEEDS_WORK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// <-- NEW ENUMS FOR E-LEARNING -->
enum BookingType {
  MENTORSHIP
  WEBINAR
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(STUDENT)

  // When the account accepted the Terms of Service and the Privacy Policy,
  // and which version (the date shown on the pages). NULL: not yet.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Raised when the password changes: the sign-in tokens given before stop
  // working (src/auth/jwt.strategy.ts)
  tokenVersion Int @default(0)

  // E-Learning Profile Fields
  avatarUrl String?
  bio       String?
  headline  String?

  // Relations
  centerId           String?
  center             Center?             @relation(fields: [centerId], references: [id])
  bookings           Booking[]
  progresses         Progress[]
  projectSubmissions ProjectSubmission[]
  questions          Question[]
  replies            Reply[]
  orders             Order[]
  quizAttempts       QuizAttempt[]
  passwordResets     PasswordReset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A forgotten password: the user asked on the Forgot password page (or a
// platform admin started it), then a platform admin created a one-time link
// and sent it by hand. Only the sha256 of the link's secret is stored.
model PasswordReset {
  id          String    @id @default(cuid())
  requestedAt DateTime? // When the user asked (null: started by an admin)
  tokenHash   String?   @unique // sha256 of the secret of the current link
  expiresAt   DateTime? // The link works until then
  usedAt      DateTime? // When the new password was set (or the reset closed)

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Center {
  id           String @id @default(cuid())
  name         String
  location     String
  contactEmail String
  contactPhone String

  // Relations
  admins   User[]
  stages   Stage[]
  coupons  Coupon[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id          String      @id @default(cuid())
  title       String
  description String?
  price       Float
  status      StageStatus @default(DRAFT)

  // E-Learning Specific Fields
  thumbnailUrl String?
  category     String?
  level        String? // e.g., Beginner, Intermediate, Advanced
  instructorId String // ID of the instructor who created it

  // The final project: what the students build and send, written by the
  // academy (plain text). NULL: the course has no project.
  projectBrief String?

  // Relations
  centerId           String
  center             Center              @relation(fields: [centerId], references: [id])
  modules            Module[] // Replaced 'lessons' with 'modules'
  projectSubmissions ProjectSubmission[]
  orderItems         OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// <-- NEW: Module Model (To group lessons) -->
model Module {
  id    String @id @default(cuid())
  title String
  order Int

  // Relations
  stageId  String
  stage    Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  quizBank QuizQuestion[] // Quizzes belonging to this module
  // The quizzes of this module finished by students
  quizAttempts QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// E-COMMERCE MODELS (COUPONS, ORDERS, PRODUCTS)
// -----------------------------------------------------------------------------

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique // e.g., BLACKFRIDAY20
  discountPercentage Float? // e.g., 20 for 20% off
  discountAmount     Float? // e.g., 50 for fixed amount off
  maxUses            Int? // Limit how many times it can be used globally
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)

  // Relations
  orders   Order[]
  // The academy that owns the coupon (empty = platform-wide, super admins only)
  centerId String?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  totalAmount Float // The final price the user pays AFTER discount
  status      OrderStatus @default(PENDING)

  // Relations
  userId   String
  user     User        @relation(fields: [userId], references: [id])
  couponId String?
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  title       String
  description String?
  price       Float
  fileUrl     String // The secure link to the PDF, ZIP, or code repository
  isActive    Boolean @default(true)

  // Relations
  orderItems OrderItem[]
  // The academy that owns the product (empty = platform-wide, super admins only)
  centerId   String?
  center     Center?     @relation(fields: [centerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id    String @id @default(cuid())
  price Float // Snapshot of the price at the exact moment of purchase

  // Relations
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stageId String?
  stage   Stage?  @relation(fields: [stageId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// E-LEARNING MODELS (LESSONS, PROGRESS, BOOKINGS)
// -----------------------------------------------------------------------------

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  duration    Int? // Duration in minutes
  order       Int

  // Relations
  moduleId   String
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses Progress[]
  questions  Question[] // Q&A Forum questions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id        String  @id @default(cuid())
  completed Boolean @default(true)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model ProjectSubmission {
  id       String           @id @default(cuid())
  repoUrl  String
  liveUrl  String?
  feedback String?
  status   SubmissionStatus @default(PENDING)

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stageId])
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)

  // 1-on-1 Mentorship / Webinar details
  title       String
  type        BookingType @default(MENTORSHIP)
  date        DateTime
  startTime   String // e.g., "14:00"
  endTime     String // e.g., "15:00"
  meetingLink String? // Zoom/Google Meet link

  // Relations
  userId       String
  user         User   @relation(fields: [userId], references: [id])
  instructorId String // ID of the instructor hosting the session

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// <-- NEW: Quiz System -->
model QuizQuestion {
  id            String         @id @default(cuid())
  text          String
  type          String // e.g., "MULTIPLE_CHOICE", "TRUE_FALSE"
  difficulty    QuizDifficulty @default(MEDIUM)
  options       String[] // Array of possible answers (e.g., ["A", "B", "C"])
  correctAnswer Int // Index of the correct option
  explanation   String?

  // Relations
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A module quiz finished by a student: how many of its questions they
// answered right (graded by the server). The course player shows their best.
model QuizAttempt {
  id      String @id @default(cuid())
  correct Int // Questions answered right
  total   Int // Questions in the quiz

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

// -----------------------------------------------------------------------------
// Q&A / DISCUSSIONS MODELS
// -----------------------------------------------------------------------------

model Question {
  id       String  @id @default(cuid())
  title    String
  body     String
  resolved Boolean @default(false)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  replies Reply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id               String  @id @default(cuid())
  body             String
  isAcceptedAnswer Boolean @default(false)

  // Relations
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
