// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  CENTER_ADMIN
  SUPER_ADMIN
}

enum StageStatus {
  DRAFT
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

// <-- NEW: Enum for project grading
enum SubmissionStatus {
  PENDING
  APPROVED
  NEEDS_WORK
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(STUDENT)

  // Student-specific fields
  licenseNumber String?

  // Relations
  centerId           String?
  center             Center?             @relation(fields: [centerId], references: [id])
  bookings           Booking[]
  progresses         Progress[]
  projectSubmissions ProjectSubmission[]
  questions          Question[] // <-- NEW: Questions asked by the user
  replies            Reply[] // <-- NEW: Replies posted by the user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id           String @id @default(cuid())
  name         String
  location     String
  contactEmail String
  contactPhone String

  // Relations
  admins User[]
  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id          String      @id @default(cuid())
  title       String
  description String?
  dateStart   DateTime
  dateEnd     DateTime
  location    String
  price       Float
  capacity    Int
  status      StageStatus @default(DRAFT)
  instructor  String

  // Relations
  centerId           String
  center             Center              @relation(fields: [centerId], references: [id])
  bookings           Booking[]
  lessons            Lesson[]
  projectSubmissions ProjectSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)

  // Payment & Documents
  stripeSessionId String? @unique
  licenseFrontUrl String?
  licenseBackUrl  String?

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stageId])
}

// -----------------------------------------------------------------------------
// NEW E-LEARNING MODELS
// -----------------------------------------------------------------------------

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  videoUrl    String? // Link to YouTube, Vimeo, or S3
  order       Int // Used to sort lessons (e.g., 1, 2, 3)

  // Relations
  stageId    String
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  progresses Progress[]
  questions  Question[] // <-- NEW: Discussions attached to this specific lesson

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id        String  @id @default(cuid())
  completed Boolean @default(true)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // A student can only complete a specific lesson once
  @@unique([userId, lessonId])
}

model ProjectSubmission {
  id       String           @id @default(cuid())
  repoUrl  String // Link to GitHub/GitLab
  liveUrl  String? // Optional: Link to Vercel/Netlify hosting
  feedback String?
  status   SubmissionStatus @default(PENDING)

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId String // The bootcamp this project belongs to
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A student should only have one active submission per bootcamp
  @@unique([userId, stageId])
}

// -----------------------------------------------------------------------------
// Q&A / DISCUSSIONS MODELS
// -----------------------------------------------------------------------------

model Question {
  id       String  @id @default(cuid())
  title    String
  body     String // The actual question/code snippet
  resolved Boolean @default(false)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  replies Reply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id               String  @id @default(cuid())
  body             String // The answer/fix
  isAcceptedAnswer Boolean @default(false)

  // Relations
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
