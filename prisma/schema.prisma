// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  STUDENT
  CENTER_ADMIN
  SUPER_ADMIN
}

enum StageStatus {
  DRAFT
  ACTIVE
  FULL
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  NEEDS_WORK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role    @default(STUDENT)

  // Student-specific fields
  licenseNumber String?

  // Relations
  centerId           String?
  center             Center?             @relation(fields: [centerId], references: [id])
  bookings           Booking[]
  progresses         Progress[]
  projectSubmissions ProjectSubmission[]
  questions          Question[]
  replies            Reply[]
  orders             Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id           String @id @default(cuid())
  name         String
  location     String
  contactEmail String
  contactPhone String

  // Relations
  admins User[]
  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id          String      @id @default(cuid())
  title       String
  description String?
  dateStart   DateTime
  dateEnd     DateTime
  location    String
  price       Float
  capacity    Int
  status      StageStatus @default(DRAFT)
  instructor  String

  // Relations
  centerId           String
  center             Center              @relation(fields: [centerId], references: [id])
  bookings           Booking[]
  lessons            Lesson[]
  projectSubmissions ProjectSubmission[]
  orderItems         OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)

  // Payment & Documents
  stripeSessionId String? @unique
  licenseFrontUrl String?
  licenseBackUrl  String?

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stageId])
}

// -----------------------------------------------------------------------------
// NEW E-COMMERCE MODELS (COUPONS & ORDERS)
// -----------------------------------------------------------------------------

// <-- NEW: Coupon Model -->
model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique // e.g., BLACKFRIDAY20
  discountPercentage Float? // e.g., 20 for 20% off
  discountAmount     Float? // e.g., 50 for fixed amount off
  maxUses            Int? // Limit how many times it can be used globally
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)

  // Relations
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  totalAmount Float // The final price the user pays AFTER discount
  status      OrderStatus @default(PENDING)

  // Relations
  userId   String
  user     User        @relation(fields: [userId], references: [id])
  couponId String? // <-- NEW: Link the applied coupon
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id    String @id @default(cuid())
  price Float // Snapshot of the stage price at the exact moment of purchase

  // Relations
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// E-LEARNING MODELS
// -----------------------------------------------------------------------------

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  order       Int

  // Relations
  stageId    String
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  progresses Progress[]
  questions  Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Progress {
  id        String  @id @default(cuid())
  completed Boolean @default(true)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model ProjectSubmission {
  id       String           @id @default(cuid())
  repoUrl  String
  liveUrl  String?
  feedback String?
  status   SubmissionStatus @default(PENDING)

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stageId])
}

// -----------------------------------------------------------------------------
// Q&A / DISCUSSIONS MODELS
// -----------------------------------------------------------------------------

model Question {
  id       String  @id @default(cuid())
  title    String
  body     String
  resolved Boolean @default(false)

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  replies Reply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id               String  @id @default(cuid())
  body             String
  isAcceptedAnswer Boolean @default(false)

  // Relations
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
